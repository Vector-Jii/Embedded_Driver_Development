/***********************************peripheral register definition structure **************************************/
/*
 * Note: Register of peripheral are specific to MCu
 * e,g Number if register of SPI peripheral of STM32x family if MCU may be differet
 * Compared to number if register of SPT peripheral
 * Please check your device RM
 */

typedef struct
{
	uint32_t MODER; 	/*GPIO port mode register (GPIOx_MODER) Address offset: 0x00 */
	uint32_t OTYPER; 	/*GPIO port output type register (GPIOx_OTYPER) Address offset: 0x04 */
	uint32_t OSPEEDR;	/*GPIO port output speed register (GPIOx_OSPEEDR) Address offset: 0x08 */
	uint32_t PUPDR;		/*GPIO port pull-up/pull-down register (GPIOx_PUPDR)) Address offset: 0x0C */
	uint32_t IDR;		/*GPIO port input data register (GPIOx_IDR) Address offset: 0x10 */
	uint32_t ODR;		/*GPIO port output data register (GPIOx_ODR) Address offset: 0x14 */
	uint32_t BSRR;		/*GPIO port bit set/reset register (GPIOx_BSRR) Address offset: 0x18 */
	uint32_t LCKR;		/*GPIO port configuration lock register (GPIOx_LCKR) Address offset: 0x1C */
	uint32_t AFRL[2];	/*AFRL[0]: GPIO alternate function low register (GPIOx_AFRL)  Address offset: 0x20*/
	//uint32_t AFRH;	/*AFRL[1]: GPIO alternate function high register (GPIOx_AFRL)  Address offset:0x24 */
}GPIO_RegDef_t;


