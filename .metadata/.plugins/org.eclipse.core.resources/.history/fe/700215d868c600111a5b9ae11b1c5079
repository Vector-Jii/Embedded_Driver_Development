#ifndef INC_STM32F407XX_H_
#define INC_STM32F407XX_H_


// From the reference manual : Table 3. Memory mapping vs. Boot mode/physical remap
#define FLASH_BASEADDRESS 				0x08000000U
#define SRAM1_BASEADDRESS 				0x20000000U
#define SRAM2_BASEADDRESS 				0x2001C000U
#define ROM_BASEADDRESS 				0x1FFF000U
#define SRAM 							SRAM1_BASEADDRESS

// AHBx and APBx peripheral bus base address

#define APB1_BASEADDRESS 				0x40000000U
#define APB2_BASEADDRESS 				0x40010000U
#define AHB1_BASEADDRESS 				0x40020000U
#define AHB2_BASEADDRESS 				0x50000000U


#endif /* INC_STM32F407XX_H_ */
